<section class="directory-content-section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-6 col-xl-5">
        <div class="card border-0 shadow-sm rounded-4">
          <div class="card-body p-4 p-md-5">
            <span class="section-label">
              Welcome back
            </span>

            <h1 class="directory-result-title mt-2 mb-3">
              Log in to TutorConnect
            </h1>

            <p class="text-secondary mb-4">
              Use your local account or GitHub identity to access the
              private tutor-management features.
            </p>

            {{#if errors}}
              <div
                class="alert alert-danger"
                role="alert"
              >
                <ul class="mb-0">
                  {{#each errors}}
                    <li>
                      {{this}}
                    </li>
                  {{/each}}
                </ul>
              </div>
            {{/if}}

            {{#if githubAuthAvailable}}
              <div class="d-grid mb-4">
                <a
                  class="btn btn-dark btn-lg d-flex align-items-center justify-content-center gap-2"
                  href="/users/github"
                >
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 16 16"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M8 0C3.58 0 0 3.64 0 8.13c0 3.59 2.29 6.64 5.47 7.71.4.08.55-.18.55-.39 0-.19-.01-.83-.01-1.51-2.01.38-2.53-.5-2.69-.96-.09-.23-.48-.96-.82-1.15-.28-.15-.68-.53-.01-.54.63-.01 1.08.59 1.23.83.72 1.23 1.87.88 2.33.67.07-.53.28-.88.51-1.08-1.78-.21-3.64-.91-3.64-4.02 0-.89.31-1.62.82-2.19-.08-.2-.36-1.04.08-2.16 0 0 .67-.22 2.2.84A7.4 7.4 0 0 1 8 3.91c.68 0 1.36.09 2 .27 1.53-1.06 2.2-.84 2.2-.84.44 1.12.16 1.96.08 2.16.51.57.82 1.3.82 2.19 0 3.12-1.87 3.81-3.65 4.02.29.25.54.74.54 1.5 0 1.08-.01 1.95-.01 2.22 0 .21.15.47.55.39A8.12 8.12 0 0 0 16 8.13C16 3.64 12.42 0 8 0Z"/>
                  </svg>

                  Continue with GitHub
                </a>
              </div>

              <div
                class="d-flex align-items-center gap-3 mb-4"
                aria-hidden="true"
              >
                <hr class="flex-grow-1 m-0">

                <span class="text-secondary small">
                  or use email
                </span>

                <hr class="flex-grow-1 m-0">
              </div>
            {{/if}}

            <form
              action="/users/login"
              method="POST"
              novalidate
            >
              <div class="mb-3">
                <label
                  class="form-label fw-semibold"
                  for="email"
                >
                  Email address
                </label>

                <input
                  class="form-control form-control-lg"
                  id="email"
                  name="email"
                  type="email"
                  value="{{email}}"
                  maxlength="150"
                  autocomplete="email"
                  required
                >
              </div>

              <div class="mb-4">
                <label
                  class="form-label fw-semibold"
                  for="password"
                >
                  Password
                </label>

                <input
                  class="form-control form-control-lg"
                  id="password"
                  name="password"
                  type="password"
                  maxlength="72"
                  autocomplete="current-password"
                  required
                >
              </div>

              <div class="d-grid">
                <button
                  class="btn btn-primary btn-lg tutor-primary-button"
                  type="submit"
                >
                  Log In
                </button>
              </div>
            </form>

            <p class="text-center text-secondary mt-4 mb-0">
              Do not have an account?

              <a
                class="fw-semibold"
                href="/users/register"
              >
                Create one now
              </a>
            </p>
          </div>
        </div>

        <p class="text-center text-secondary small mt-3">
          GitHub authentication stores your GitHub profile ID and
          basic profile information in TutorConnect.
        </p>
      </div>
    </div>
  </div>
</section>