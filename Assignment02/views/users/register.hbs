<section class="directory-content-section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-7 col-xl-6">
        <div class="card border-0 shadow-sm rounded-4">
          <div class="card-body p-4 p-md-5">
            <span class="section-label">
              Create an account
            </span>

            <h1 class="directory-result-title mt-2 mb-3">
              Register for TutorConnect
            </h1>

            <p class="text-secondary mb-4">
              Create a local account to access the private tutor
              management features.
            </p>

            {{#if errors}}
              <div
                class="alert alert-danger"
                role="alert"
              >
                <strong>
                  Please correct the following:
                </strong>

                <ul class="mb-0 mt-2">
                  {{#each errors}}
                    <li>
                      {{this}}
                    </li>
                  {{/each}}
                </ul>
              </div>
            {{/if}}

            <form
              action="/users/register"
              method="POST"
              novalidate
            >
              <div class="mb-3">
                <label
                  class="form-label fw-semibold"
                  for="displayName"
                >
                  Display name
                </label>

                <input
                  class="form-control form-control-lg"
                  id="displayName"
                  name="displayName"
                  type="text"
                  value="{{formData.displayName}}"
                  minlength="2"
                  maxlength="80"
                  autocomplete="name"
                  required
                >

                <div class="form-text">
                  This name will appear in the navigation after login.
                </div>
              </div>

              <div class="mb-3">
                <label
                  class="form-label fw-semibold"
                  for="email"
                >
                  Email address
                </label>

                <input
                  class="form-control form-control-lg"
                  id="email"
                  name="email"
                  type="email"
                  value="{{formData.email}}"
                  maxlength="150"
                  autocomplete="email"
                  required
                >
              </div>

              <div class="mb-3">
                <label
                  class="form-label fw-semibold"
                  for="password"
                >
                  Password
                </label>

                <input
                  class="form-control form-control-lg"
                  id="password"
                  name="password"
                  type="password"
                  minlength="8"
                  maxlength="72"
                  autocomplete="new-password"
                  required
                >

                <div class="form-text">
                  Use at least 8 characters.
                </div>
              </div>

              <div class="mb-4">
                <label
                  class="form-label fw-semibold"
                  for="confirmPassword"
                >
                  Confirm password
                </label>

                <input
                  class="form-control form-control-lg"
                  id="confirmPassword"
                  name="confirmPassword"
                  type="password"
                  minlength="8"
                  maxlength="72"
                  autocomplete="new-password"
                  required
                >
              </div>

              <div class="d-grid">
                <button
                  class="btn btn-primary btn-lg tutor-primary-button"
                  type="submit"
                >
                  Create Account
                </button>
              </div>
            </form>

            <p class="text-center text-secondary mt-4 mb-0">
              Already registered?

              <a
                class="fw-semibold"
                href="/users/login"
              >
                Log in to your account
              </a>
            </p>
          </div>
        </div>

        <p class="text-center text-secondary small mt-3">
          Passwords are stored as secure hashes rather than plain
          text.
        </p>
      </div>
    </div>
  </div>
</section>