<section class="directory-hero">
  <div class="container">
    <div class="directory-heading">
      <span class="section-label">
        Protected management area
      </span>

      <h1>
        Edit tutor
      </h1>

      <p>
        Update the profile information for {{tutorName}}. Saved
        changes will immediately appear in the public directory and
        search results.
      </p>
    </div>
  </div>
</section>

<section class="directory-content-section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-xl-10">
        <div
          class="card border-0 shadow-sm rounded-4"
        >
          <div class="card-body p-4 p-lg-5">
            <div
              class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4"
            >
              <div>
                <p class="directory-result-label">
                  Existing database record
                </p>

                <h2 class="directory-result-title">
                  Update tutor profile
                </h2>
              </div>

              <span
                class="badge rounded-pill text-bg-primary px-3 py-2"
              >
                Editing {{tutorName}}
              </span>
            </div>

            {{#if errors}}
              <div
                class="alert alert-danger rounded-4"
                role="alert"
              >
                <strong>
                  The tutor record could not be updated.
                </strong>

                <p class="mb-2">
                  Correct the following information:
                </p>

                <ul class="mb-0">
                  {{#each errors}}
                    <li>
                      {{this}}
                    </li>
                  {{/each}}
                </ul>
              </div>
            {{/if}}

            <form
              action="/tutors/{{tutorId}}/edit"
              method="POST"
              novalidate
            >
              <div class="row g-4">
                <div class="col-md-6">
                  <label
                    class="form-label fw-semibold"
                    for="name"
                  >
                    Tutor name
                  </label>

                  <input
                    class="form-control form-control-lg"
                    id="name"
                    name="name"
                    type="text"
                    value="{{formData.name}}"
                    minlength="2"
                    maxlength="80"
                    autocomplete="name"
                    required
                  >
                </div>

                <div class="col-md-6">
                  <label
                    class="form-label fw-semibold"
                    for="contactEmail"
                  >
                    Contact email
                  </label>

                  <input
                    class="form-control form-control-lg"
                    id="contactEmail"
                    name="contactEmail"
                    type="email"
                    value="{{formData.contactEmail}}"
                    maxlength="150"
                    autocomplete="email"
                    required
                  >
                </div>

                <div class="col-md-7">
                  <label
                    class="form-label fw-semibold"
                    for="subject"
                  >
                    Subject
                  </label>

                  <input
                    class="form-control form-control-lg"
                    id="subject"
                    name="subject"
                    type="text"
                    value="{{formData.subject}}"
                    minlength="2"
                    maxlength="100"
                    required
                  >
                </div>

                <div class="col-md-5">
                  <label
                    class="form-label fw-semibold"
                    for="courseCode"
                  >
                    Course code
                  </label>

                  <input
                    class="form-control form-control-lg"
                    id="courseCode"
                    name="courseCode"
                    type="text"
                    value="{{formData.courseCode}}"
                    minlength="3"
                    maxlength="20"
                    required
                  >

                  <div class="form-text">
                    The course code is stored in uppercase.
                  </div>
                </div>

                <div class="col-12">
                  <label
                    class="form-label fw-semibold"
                    for="skills"
                  >
                    Tutoring skills
                  </label>

                  <input
                    class="form-control form-control-lg"
                    id="skills"
                    name="skills"
                    type="text"
                    value="{{formData.skills}}"
                    maxlength="250"
                    required
                  >

                  <div class="form-text">
                    Separate multiple skills with commas.
                  </div>
                </div>

                <div class="col-md-6">
                  <label
                    class="form-label fw-semibold"
                    for="availability"
                  >
                    Availability
                  </label>

                  <input
                    class="form-control form-control-lg"
                    id="availability"
                    name="availability"
                    type="text"
                    value="{{formData.availability}}"
                    maxlength="150"
                    required
                  >
                </div>

                <div class="col-md-6">
                  <label
                    class="form-label fw-semibold"
                    for="location"
                  >
                    Location
                  </label>

                  <input
                    class="form-control form-control-lg"
                    id="location"
                    name="location"
                    type="text"
                    value="{{formData.location}}"
                    maxlength="100"
                    required
                  >
                </div>

                <div class="col-md-6">
                  <label
                    class="form-label fw-semibold"
                    for="tutoringFormat"
                  >
                    Tutoring format
                  </label>

                  <select
                    class="form-select form-select-lg"
                    id="tutoringFormat"
                    name="tutoringFormat"
                    required
                  >
                    <option value="">
                      Select a format
                    </option>

                    <option
                      value="Online"
                      {{#if formData.isOnline}}selected{{/if}}
                    >
                      Online
                    </option>

                    <option
                      value="In person"
                      {{#if formData.isInPerson}}selected{{/if}}
                    >
                      In person
                    </option>

                    <option
                      value="Hybrid"
                      {{#if formData.isHybrid}}selected{{/if}}
                    >
                      Hybrid
                    </option>
                  </select>
                </div>

                <div class="col-md-6">
                  <label
                    class="form-label fw-semibold"
                    for="experienceLevel"
                  >
                    Experience level
                  </label>

                  <select
                    class="form-select form-select-lg"
                    id="experienceLevel"
                    name="experienceLevel"
                    required
                  >
                    <option value="">
                      Select an experience level
                    </option>

                    <option
                      value="Beginner"
                      {{#if formData.isBeginner}}selected{{/if}}
                    >
                      Beginner
                    </option>

                    <option
                      value="Intermediate"
                      {{#if formData.isIntermediate}}selected{{/if}}
                    >
                      Intermediate
                    </option>

                    <option
                      value="Advanced"
                      {{#if formData.isAdvanced}}selected{{/if}}
                    >
                      Advanced
                    </option>

                    <option
                      value="Expert"
                      {{#if formData.isExpert}}selected{{/if}}
                    >
                      Expert
                    </option>
                  </select>
                </div>

                <div class="col-12">
                  <label
                    class="form-label fw-semibold"
                    for="description"
                  >
                    Tutor description
                  </label>

                  <textarea
                    class="form-control"
                    id="description"
                    name="description"
                    rows="6"
                    minlength="20"
                    maxlength="600"
                    required
                  >{{formData.description}}</textarea>

                  <div class="form-text">
                    Enter between 20 and 600 characters.
                  </div>
                </div>
              </div>

              <div
                class="d-flex flex-column flex-sm-row gap-3 mt-5 pt-4 border-top"
              >
                <button
                  class="btn btn-primary btn-lg tutor-primary-button"
                  type="submit"
                >
                  Save Tutor Changes
                </button>

                <a
                  class="btn btn-outline-secondary btn-lg"
                  href="/tutors/manage"
                >
                  Cancel
                </a>
              </div>
            </form>
          </div>
        </div>

        <div class="directory-access-note">
          <strong>
            Search update:
          </strong>

          Saving this form refreshes the tutor’s searchable information
          so updated names, subjects, course codes, skills, and other
          details can be found through the public directory.
        </div>
      </div>
    </div>
  </div>
</section>