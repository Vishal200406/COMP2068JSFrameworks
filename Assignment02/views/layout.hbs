<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >

  <meta
    name="description"
    content="TutorConnect Directory helps students find peer tutors by subject, course code, availability, experience, and tutoring format."
  >

  <title>{{title}} | TutorConnect Directory</title>

  <!-- Bootstrap provides responsive interface components. -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- TutorConnect custom styles load after Bootstrap. -->
  <link
    rel="stylesheet"
    href="/stylesheets/style.css"
  >
</head>

<body class="d-flex flex-column min-vh-100">
  <header>
    <nav
      class="navbar navbar-expand-lg tutor-navbar"
      data-bs-theme="dark"
      aria-label="Main navigation"
    >
      <div class="container">
        <a
          class="navbar-brand d-flex align-items-center gap-2"
          href="/"
          aria-label="TutorConnect Directory home"
        >
          <span
            class="brand-mark"
            aria-hidden="true"
          >
            TC
          </span>

          <span class="brand-text">
            TutorConnect
            <small>Directory</small>
          </span>
        </a>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mainNavigation"
          aria-controls="mainNavigation"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div
          class="collapse navbar-collapse"
          id="mainNavigation"
        >
          <ul
            class="navbar-nav ms-auto align-items-lg-center gap-lg-2"
          >
            <li class="nav-item">
              <a
                class="nav-link"
                href="/"
              >
                Home
              </a>
            </li>

            <li class="nav-item">
              <a
                class="nav-link"
                href="/tutors"
              >
                Tutor Directory
              </a>
            </li>

            <li class="nav-item">
              <a
                class="nav-link"
                href="/#features"
              >
                Features
              </a>
            </li>

            <li class="nav-item">
              <a
                class="nav-link"
                href="/#how-it-works"
              >
                How It Works
              </a>
            </li>

            {{#if isAuthenticated}}
              <li class="nav-item">
                <a
                  class="nav-link"
                  href="/tutors/manage"
                >
                  Manage Tutors
                </a>
              </li>

              <li class="nav-item ms-lg-2">
                <span class="navbar-text text-white">
                  Hello, {{currentUser.displayName}}
                </span>
              </li>

              <li class="nav-item">
                <form
                  action="/users/logout"
                  method="POST"
                  class="m-0"
                >
                  <button
                    class="btn btn-light tutor-nav-button"
                    type="submit"
                  >
                    Log Out
                  </button>
                </form>
              </li>
            {{else}}
              <li class="nav-item ms-lg-2">
                <a
                  class="nav-link"
                  href="/users/register"
                >
                  Register
                </a>
              </li>

              <li class="nav-item">
                <a
                  class="btn btn-light tutor-nav-button"
                  href="/users/login"
                >
                  Log In
                </a>
              </li>
            {{/if}}
          </ul>
        </div>
      </div>
    </nav>
  </header>

  {{#if successMessage}}
    <div class="container mt-3">
      <div
        class="alert alert-success alert-dismissible fade show"
        role="alert"
      >
        {{successMessage}}

        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="alert"
          aria-label="Close"
        ></button>
      </div>
    </div>
  {{/if}}

  {{#if errorMessage}}
    <div class="container mt-3">
      <div
        class="alert alert-danger alert-dismissible fade show"
        role="alert"
      >
        {{errorMessage}}

        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="alert"
          aria-label="Close"
        ></button>
      </div>
    </div>
  {{/if}}

  <main class="flex-grow-1">
    {{{body}}}
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="row gy-4 align-items-start">
        <div class="col-lg-5">
          <a
            class="footer-brand d-inline-flex align-items-center gap-2"
            href="/"
          >
            <span
              class="brand-mark brand-mark-small"
              aria-hidden="true"
            >
              TC
            </span>

            <span>
              TutorConnect Directory
            </span>
          </a>

          <p class="footer-description">
            A centralized directory designed to help students discover
            peer tutors for courses, subjects, and academic skills.
          </p>
        </div>

        <div class="col-6 col-lg-3">
          <h2 class="footer-heading">
            Explore
          </h2>

          <ul class="footer-links">
            <li>
              <a href="/">
                Home
              </a>
            </li>

            <li>
              <a href="/tutors">
                Tutor Directory
              </a>
            </li>

            <li>
              <a href="/#features">
                Features
              </a>
            </li>

            {{#if isAuthenticated}}
              <li>
                <a href="/tutors/manage">
                  Manage Tutors
                </a>
              </li>
            {{else}}
              <li>
                <a href="/users/register">
                  Register
                </a>
              </li>

              <li>
                <a href="/users/login">
                  Log In
                </a>
              </li>
            {{/if}}
          </ul>
        </div>

        <div class="col-6 col-lg-4">
          <h2 class="footer-heading">
            Project
          </h2>

          <p class="footer-note">
            Developed as an individual COMP 2068 Assignment 2 project
            using Node.js, Express, HBS, MongoDB, and Mongoose.
          </p>
        </div>
      </div>

      <div class="footer-bottom">
        <p class="mb-0">
          &copy; 2026 TutorConnect Directory. Academic project.
        </p>
      </div>
    </div>
  </footer>

  <!-- Bootstrap bundle enables responsive navigation and alerts. -->
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
  ></script>
</body>
</html>