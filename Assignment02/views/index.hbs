<section class="hero-section">
  <div class="container">
    <div class="row align-items-center gy-5">
      <div class="col-lg-6">
        <span class="hero-badge">
          Peer tutoring made easier
        </span>

        <h1 class="hero-title">
          Find the right tutor for your next academic challenge.
        </h1>

        <p class="hero-description">
          {{pageDescription}}
          TutorConnect brings peer-tutor information together in one
          accessible and organized online directory.
        </p>

        <div class="d-flex flex-column flex-sm-row gap-3">
          <a
            class="btn btn-primary tutor-primary-button"
            href="/tutors"
          >
            Browse Tutor Directory
          </a>

          <a
            class="btn btn-outline-primary tutor-secondary-button"
            href="#how-it-works"
          >
            See How It Works
          </a>
        </div>

        <div
          class="hero-benefits"
          aria-label="Application highlights"
        >
          <div class="hero-benefit">
            <span
              class="benefit-check"
              aria-hidden="true"
            >
              ✓
            </span>

            Public tutor browsing
          </div>

          <div class="hero-benefit">
            <span
              class="benefit-check"
              aria-hidden="true"
            >
              ✓
            </span>

            Course-based discovery
          </div>

          <div class="hero-benefit">
            <span
              class="benefit-check"
              aria-hidden="true"
            >
              ✓
            </span>

            Flexible tutoring formats
          </div>
        </div>
      </div>

      <div
        class="col-lg-6"
        id="directory-preview"
      >
        <div class="directory-preview-card">
          <div class="preview-header">
            <div>
              <span class="preview-label">
                Directory preview
              </span>

              <h2 class="preview-title">
                Find a peer tutor
              </h2>
            </div>

            <span class="preview-status">
              Available now
            </span>
          </div>

          <div class="search-preview">
            <span
              class="search-symbol"
              aria-hidden="true"
            >
              ⌕
            </span>

            <span class="search-placeholder">
              Search by tutor, subject, or course code
            </span>
          </div>

          <div class="preview-list">
            <article class="tutor-preview-item">
              <div
                class="tutor-avatar"
                aria-hidden="true"
              >
                AM
              </div>

              <div class="tutor-preview-content">
                <div class="d-flex justify-content-between gap-3">
                  <div>
                    <h3 class="tutor-preview-name">
                      Alex Morgan
                    </h3>

                    <p class="tutor-preview-subject">
                      JavaScript Fundamentals
                    </p>
                  </div>

                  <span class="course-badge">
                    COMP 2068
                  </span>
                </div>

                <div class="tutor-preview-details">
                  <span>Online</span>
                  <span>Evenings</span>
                  <span>Advanced</span>
                </div>
              </div>
            </article>

            <article class="tutor-preview-item">
              <div
                class="tutor-avatar"
                aria-hidden="true"
              >
                SP
              </div>

              <div class="tutor-preview-content">
                <div class="d-flex justify-content-between gap-3">
                  <div>
                    <h3 class="tutor-preview-name">
                      Sam Patel
                    </h3>

                    <p class="tutor-preview-subject">
                      Database Systems
                    </p>
                  </div>

                  <span class="course-badge">
                    COMP 2003
                  </span>
                </div>

                <div class="tutor-preview-details">
                  <span>Hybrid</span>
                  <span>Weekends</span>
                  <span>Expert</span>
                </div>
              </div>
            </article>

            <article class="tutor-preview-item">
              <div
                class="tutor-avatar"
                aria-hidden="true"
              >
                JL
              </div>

              <div class="tutor-preview-content">
                <div class="d-flex justify-content-between gap-3">
                  <div>
                    <h3 class="tutor-preview-name">
                      Jordan Lee
                    </h3>

                    <p class="tutor-preview-subject">
                      Applied Mathematics
                    </p>
                  </div>

                  <span class="course-badge">
                    MATH 1002
                  </span>
                </div>

                <div class="tutor-preview-details">
                  <span>In person</span>
                  <span>Afternoons</span>
                  <span>Advanced</span>
                </div>
              </div>
            </article>
          </div>

          <div class="d-grid mt-3">
            <a
              class="btn btn-primary tutor-primary-button"
              href="/tutors"
            >
              Open Full Tutor Directory
            </a>
          </div>

          <p class="preview-disclaimer">
            The sample profiles shown are fictional and are used for
            academic project demonstration.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="trust-section">
  <div class="container">
    <div class="row g-3">
      <div class="col-md-4">
        <div class="trust-item">
          <span class="trust-number">
            01
          </span>

          <div>
            <h2>
              Organized profiles
            </h2>

            <p>
              Review course, availability, tutoring format, contact,
              location, and experience information in one place.
            </p>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="trust-item">
          <span class="trust-number">
            02
          </span>

          <div>
            <h2>
              Public access
            </h2>

            <p>
              Students can browse the public tutor directory without
              registering or logging in.
            </p>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="trust-item">
          <span class="trust-number">
            03
          </span>

          <div>
            <h2>
              Focused searching
            </h2>

            <p>
              Search tutor names, subjects, course codes, skills,
              locations, availability, and tutoring formats.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section
  class="content-section"
  id="features"
>
  <div class="container">
    <div class="section-heading text-center">
      <span class="section-label">
        Directory features
      </span>

      <h2>
        Everything needed to connect students and peer tutors
      </h2>

      <p>
        TutorConnect combines public tutor discovery with secure tutor
        record management for authenticated users.
      </p>
    </div>

    <div class="row g-4">
      <div class="col-md-6 col-xl-3">
        <article class="feature-card h-100">
          <div
            class="feature-icon"
            aria-hidden="true"
          >
            01
          </div>

          <h3>
            Public directory
          </h3>

          <p>
            Browse available peer tutors and review their academic
            information without logging in.
          </p>
        </article>
      </div>

      <div class="col-md-6 col-xl-3">
        <article class="feature-card h-100">
          <div
            class="feature-icon"
            aria-hidden="true"
          >
            02
          </div>

          <h3>
            Fuzzy search
          </h3>

          <p>
            Find relevant tutor profiles even when a search term is
            incomplete or does not exactly match a database value.
          </p>
        </article>
      </div>

      <div class="col-md-6 col-xl-3">
        <article class="feature-card h-100">
          <div
            class="feature-icon"
            aria-hidden="true"
          >
            03
          </div>

          <h3>
            Secure management
          </h3>

          <p>
            Registered users will create, edit, and delete tutor
            listings through protected application pages.
          </p>
        </article>
      </div>

      <div class="col-md-6 col-xl-3">
        <article class="feature-card h-100">
          <div
            class="feature-icon"
            aria-hidden="true"
          >
            04
          </div>

          <h3>
            Flexible formats
          </h3>

          <p>
            Tutor profiles identify online, in-person, and hybrid
            tutoring options for different student needs.
          </p>
        </article>
      </div>
    </div>
  </div>
</section>

<section
  class="process-section"
  id="how-it-works"
>
  <div class="container">
    <div class="row align-items-center gy-5">
      <div class="col-lg-5">
        <span class="section-label">
          How it works
        </span>

        <h2 class="process-title">
          A straightforward way to find academic support
        </h2>

        <p class="process-introduction">
          TutorConnect guides students from tutor discovery to direct
          contact without unnecessary registration steps.
        </p>
      </div>

      <div class="col-lg-7">
        <div class="process-list">
          <article class="process-item">
            <span class="process-number">
              1
            </span>

            <div>
              <h3>
                Browse the directory
              </h3>

              <p>
                Open the public directory and review all available peer
                tutor profiles.
              </p>
            </div>
          </article>

          <article class="process-item">
            <span class="process-number">
              2
            </span>

            <div>
              <h3>
                Search for a suitable tutor
              </h3>

              <p>
                Enter a tutor name, subject, course code, skill,
                location, availability, experience, or tutoring format.
              </p>
            </div>
          </article>

          <article class="process-item">
            <span class="process-number">
              3
            </span>

            <div>
              <h3>
                Review and make contact
              </h3>

              <p>
                Compare tutor details and use the listed email address
                to contact the selected peer tutor.
              </p>
            </div>
          </article>
        </div>
      </div>
    </div>
  </div>
</section>

<section
  class="about-section"
  id="about"
>
  <div class="container">
    <div class="about-panel">
      <div class="row align-items-center gy-4">
        <div class="col-lg-8">
          <span class="section-label section-label-light">
            About TutorConnect
          </span>

          <h2>
            One central location for peer-tutoring opportunities
          </h2>

          <p>
            TutorConnect Directory is designed to replace tutor
            information scattered across class chats, social media,
            and word-of-mouth recommendations with a structured,
            searchable, and accessible online directory.
          </p>
        </div>

        <div class="col-lg-4 text-lg-end">
          <a
            class="btn btn-light about-button"
            href="/tutors"
          >
            Browse Tutor Directory
          </a>
        </div>
      </div>
    </div>
  </div>
</section>