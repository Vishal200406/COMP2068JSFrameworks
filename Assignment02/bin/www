#!/usr/bin/env node

/**
 * Load private environment variables before loading the application
 * or connecting to MongoDB.
 */
require('dotenv').config({
  quiet: true
});

var debug = require('debug')('assignment02:server');
var http = require('http');

var connectToDatabase = require('../config/database');

/**
 * Get the port from the environment and normalize it.
 */
var port = normalizePort(
  process.env.PORT || '3000'
);

/**
 * Connect to MongoDB before loading the Express application.
 *
 * app.js configures the MongoDB-backed session store using the active
 * Mongoose connection, so the database must be connected first.
 */
async function startApplication() {
  try {
    await connectToDatabase();

    console.log(
      'MongoDB Atlas connected successfully.'
    );

    /*
     * Load the application only after Mongoose has established its
     * connection. This lets connect-mongo reuse that connection.
     */
    var app = require('../app');

    app.set('port', port);

    var server = http.createServer(app);

    server.on('error', function handleServerError(error) {
      onError(error, port);
    });

    server.on('listening', function handleListening() {
      onListening(server);
    });

    server.listen(port);
  } catch (error) {
    console.error('Application startup failed:');
    console.error(error.message);

    process.exit(1);
  }
}

startApplication();

/**
 * Normalize a port into a number, string, or false.
 *
 * @param {string} value Port value from the environment.
 * @returns {number|string|boolean} Normalized port.
 */
function normalizePort(value) {
  var parsedPort = parseInt(value, 10);

  if (isNaN(parsedPort)) {
    return value;
  }

  if (parsedPort >= 0) {
    return parsedPort;
  }

  return false;
}

/**
 * Handle HTTP server startup errors.
 *
 * @param {NodeJS.ErrnoException} error Server error.
 * @param {number|string|boolean} activePort Active server port.
 */
function onError(error, activePort) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind =
    typeof activePort === 'string'
      ? 'Pipe ' + activePort
      : 'Port ' + activePort;

  switch (error.code) {
    case 'EACCES':
      console.error(
        bind + ' requires elevated privileges.'
      );

      process.exit(1);
      break;

    case 'EADDRINUSE':
      console.error(
        bind + ' is already in use.'
      );

      process.exit(1);
      break;

    default:
      throw error;
  }
}

/**
 * Report that the HTTP server is listening.
 *
 * @param {http.Server} server Active HTTP server.
 */
function onListening(server) {
  var address = server.address();

  var bind =
    typeof address === 'string'
      ? 'pipe ' + address
      : 'port ' + address.port;

  console.log(
    'TutorConnect Directory is running on ' +
      bind +
      '.'
  );

  debug('Listening on ' + bind);
}