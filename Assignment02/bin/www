#!/usr/bin/env node

/**
 * Load private environment variables before importing the application
 * or attempting to connect to MongoDB.
 */
require('dotenv').config();

var app = require('../app');
var debug = require('debug')('assignment02:server');
var http = require('http');

var connectToDatabase = require('../config/database');

/**
 * Get the port from the environment and store it in Express.
 */
var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create the HTTP server.
 */
var server = http.createServer(app);

/**
 * Register server event handlers before starting the application.
 */
server.on('error', onError);
server.on('listening', onListening);

/**
 * Connect to MongoDB before accepting web requests.
 *
 * The application exits when the database connection cannot be
 * established. This prevents the website from appearing operational
 * while its required database is unavailable.
 */
async function startApplication() {
  try {
    await connectToDatabase();

    console.log('MongoDB Atlas connected successfully.');

    server.listen(port);
  } catch (error) {
    console.error('MongoDB connection failed:');
    console.error(error.message);

    process.exit(1);
  }
}

startApplication();

/**
 * Normalize a port into a number, string, or false.
 *
 * @param {string} value Port supplied through the environment.
 * @returns {number|string|boolean} Normalized port value.
 */
function normalizePort(value) {
  var parsedPort = parseInt(value, 10);

  if (isNaN(parsedPort)) {
    return value;
  }

  if (parsedPort >= 0) {
    return parsedPort;
  }

  return false;
}

/**
 * Handle HTTP server errors.
 *
 * @param {NodeJS.ErrnoException} error Server startup error.
 */
function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind =
    typeof port === 'string'
      ? 'Pipe ' + port
      : 'Port ' + port;

  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;

    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;

    default:
      throw error;
  }
}

/**
 * Report that the HTTP server has started successfully.
 */
function onListening() {
  var address = server.address();

  var bind =
    typeof address === 'string'
      ? 'pipe ' + address
      : 'port ' + address.port;

  console.log('TutorConnect Directory is running on ' + bind + '.');

  debug('Listening on ' + bind);
}